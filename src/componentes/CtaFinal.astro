---
import { empresa, zap } from '../dados/site';

interface Props {
  titulo?: string;
  texto?: string;
  zapMensagem: string;
}
const {
  titulo = 'Veja o sistema rodando com a sua operação',
  texto = 'Demonstração de 30 minutos, conduzida por quem entende de transporte. Sem compromisso e sem script de call center.',
  zapMensagem,
} = Astro.props;
---

<section class="cta">
  <div class="faixa cta-conteudo">
    <div class="cta-texto">
      <h2>{titulo}</h2>
      <p>{texto}</p>
    </div>

    <div class="cta-acoes">
      <a href="/demonstracao/" class="botao botao-acao">Agendar demonstração</a>
      <a href={zap(zapMensagem)} class="botao botao-zap" target="_blank" rel="noopener">
        Falar no WhatsApp
      </a>
      <a href={`tel:${empresa.telefoneLink}`} class="botao botao-fantasma tel">
        {empresa.telefone}
      </a>
    </div>
  </div>
</section>

<style>
  /* Era quase-preto e caia colado no rodape, que tambem e escuro: toda
     pagina terminava num bloco preto de duas alturas. Em azul da marca o
     fechamento continua forte, separa do rodape e tira a maior mancha
     escura do site. Branco sobre este azul da 8,1:1. */
  .cta {
    background:
      radial-gradient(90% 120% at 88% 0%, #00679F 0%, transparent 62%),
      var(--azul-esc);
    color: #fff;
  }
  /* texto em cima, botoes lado a lado embaixo: em coluna estreita
     eles ficavam empilhados e sobrava tela vazia à esquerda */
  .cta-conteudo {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 26px;
  }
  .cta-texto {
    max-width: 58ch;
  }
  .cta h2 {
    color: #fff;
    /* sobre azul o contraste e menor que sobre quase-preto, entao aqui
       nao ha halo para compensar: o peso volta ao normal do titulo */
    margin-bottom: 10px;
  }
  .cta p {
    color: #CFE3F2;
    margin: 0;
    font-size: 17.5px;
  }
  .cta-acoes {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .cta-acoes .botao {
    min-width: 220px;
  }
  /* sobre o azul, o verde do WhatsApp e o laranja ficam perto demais em
     luminancia (1,5:1 o verde) e a borda do botao some. Um fio claro de
     1px resolve sem mexer na cor do botao, que e a mesma do resto do site. */
  .cta-acoes .botao-zap,
  .cta-acoes .botao-acao {
    border-color: rgba(255, 255, 255, 0.34);
  }
  .tel {
    font-family: var(--f-mono);
    letter-spacing: -0.01em;
  }

  @media (max-width: 560px) {
    .cta-acoes {
      width: 100%;
    }
    .cta-acoes .botao {
      width: 100%;
    }
  }
</style>
