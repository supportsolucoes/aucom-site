---
import { empresa, zap } from '../dados/site';

interface Props {
  titulo?: string;
  texto?: string;
  zapMensagem: string;
}
const {
  titulo = 'Veja o sistema rodando com a sua operação',
  texto = 'Demonstração de 30 minutos, conduzida por quem entende de transporte. Sem compromisso e sem script de call center.',
  zapMensagem,
} = Astro.props;
---

<section class="cta">
  <div class="faixa cta-conteudo">
    <div class="cta-texto">
      <h2>{titulo}</h2>
      <p>{texto}</p>
    </div>

    <div class="cta-acoes">
      <a href="/demonstracao/" class="botao botao-acao">Agendar demonstração</a>
      <a href={zap(zapMensagem)} class="botao botao-zap" target="_blank" rel="noopener">
        Falar no WhatsApp
      </a>
      <a href={`tel:${empresa.telefoneLink}`} class="botao botao-fantasma tel">
        {empresa.telefone}
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--tinta);
    color: #fff;
  }
  /* texto em cima, botoes lado a lado embaixo: em coluna estreita
     eles ficavam empilhados e sobrava tela vazia à esquerda */
  .cta-conteudo {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 26px;
  }
  .cta-texto {
    max-width: 58ch;
  }
  .cta h2 {
    color: #fff;
    margin-bottom: 10px;
  }
  .cta p {
    color: #A9BECA;
    margin: 0;
    font-size: 17.5px;
  }
  .cta-acoes {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .cta-acoes .botao {
    min-width: 220px;
  }
  .tel {
    font-family: var(--f-mono);
    letter-spacing: -0.01em;
  }

  @media (max-width: 560px) {
    .cta-acoes {
      width: 100%;
    }
    .cta-acoes .botao {
      width: 100%;
    }
  }
</style>
