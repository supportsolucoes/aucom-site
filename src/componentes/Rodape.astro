---
import { empresa, modulos, modulosRisco } from '../dados/site';
import Marca from './Marca.astro';
const ano = new Date().getFullYear();
---

<footer class="rodape">
  <div class="faixa">
    <div class="colunas">
      <div class="col marca-col">
        <Marca claro altura={32} />
        <p>
          Sistemas para transportadoras há mais de {empresa.anos} anos, em {empresa.cidade}/{empresa.uf}.
        </p>
        <div class="sociais">
          <a href={empresa.sociais.linkedin} rel="noopener">LinkedIn</a>
          <a href={empresa.sociais.instagram} rel="noopener">Instagram</a>
          <a href={empresa.sociais.youtube} rel="noopener">YouTube</a>
          <a href={empresa.sociais.facebook} rel="noopener">Facebook</a>
        </div>
      </div>

      <div class="col">
        <span class="rotulo">TMS</span>
        <ul>
          <li><a href="/tms/">Visão geral</a></li>
          {modulos.slice(0, 5).map((m) => (
            <li><a href={`/tms/${m.slug}/`}>{m.nome}</a></li>
          ))}
        </ul>
      </div>

      <div class="col">
        <span class="rotulo">Também no TMS</span>
        <ul>
          {modulos.slice(5).map((m) => (
            <li><a href={`/tms/${m.slug}/`}>{m.nome}</a></li>
          ))}
          <li><a href="/gerenciamento-de-risco/">Gerenciamento de risco</a></li>
          {modulosRisco.map((m) => (
            <li><a href={`/gerenciamento-de-risco/${m.slug}/`}>{m.nome}</a></li>
          ))}
        </ul>
      </div>

      <div class="col">
        <span class="rotulo">Empresa</span>
        <ul>
          <li><a href="/erp/">ERP</a></li>
          <li><a href="/planos/">Planos</a></li>
          <li><a href="/clientes/">Clientes</a></li>
          <li><a href="/sobre/">Sobre a Aucom</a></li>
          <li><a href="/contato/">Contato</a></li>
          <li><a href={empresa.areaCliente} rel="noopener">Área do cliente</a></li>
        </ul>
      </div>

      <div class="col">
        <span class="rotulo">Atendimento</span>
        <ul>
          <li><a href={`tel:${empresa.telefoneLink}`}>{empresa.telefone}</a></li>
          <li><a href={`mailto:${empresa.email}`}>{empresa.email}</a></li>
          <li class="sem-link">{empresa.horario}</li>
          <li class="sem-link">{empresa.cidade} — {empresa.uf}</li>
        </ul>
      </div>
    </div>

    <div class="base">
      <span>© {ano} {empresa.nomeCompleto}. Todos os direitos reservados.</span>
      <div class="legais">
        <a href="/politica-de-privacidade/">Política de privacidade</a>
        <a href="/termos-e-condicoes/">Termos e condições</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .rodape {
    background: var(--tinta);
    color: #B8C9D3;
    padding: 36px 0 18px;
    font-size: 14px;
  }
  .colunas {
    display: grid;
    grid-template-columns: 1.5fr repeat(4, 1fr);
    gap: 24px 22px;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-width: 0;
  }
  .marca-col {
    gap: 10px;
  }
  .marca-col p {
    font-size: 13.5px;
    line-height: 1.5;
    max-width: 30ch;
    color: #92AAB8;
    margin: 0;
  }
  .rotulo {
    color: #6D8797;
  }
  .col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .col a {
    color: #D5E1E8;
    text-decoration: none;
    font-size: 13.8px;
  }
  .col a:hover {
    color: var(--ciano);
    text-decoration: underline;
  }
  .col .sem-link {
    color: #92AAB8;
    font-size: 13.8px;
  }
  .sociais {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin-top: 2px;
  }
  .sociais a {
    color: #D5E1E8;
    text-decoration: none;
    font-family: var(--f-mono);
    font-size: 12px;
  }
  .sociais a:hover {
    color: var(--ciano);
  }

  .base {
    margin-top: 26px;
    padding-top: 14px;
    border-top: 1px solid #233945;
    display: flex;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 12.8px;
    color: #7E96A4;
  }
  .legais {
    display: flex;
    gap: 18px;
  }
  .legais a {
    color: #7E96A4;
    text-decoration: none;
  }
  .legais a:hover {
    color: var(--ciano);
  }

  @media (max-width: 900px) {
    .colunas {
      grid-template-columns: repeat(2, 1fr);
    }
    .marca-col {
      grid-column: 1 / -1;
    }
  }
</style>
