---
interface Props {
  itens: { texto: string; href?: string }[];
}
const { itens } = Astro.props;
---

<nav class="migalhas" aria-label="Você está em">
  <ol>
    <li><a href="/">Início</a></li>
    {itens.map((i) => (
      <li>{i.href ? <a href={i.href}>{i.texto}</a> : <span aria-current="page">{i.texto}</span>}</li>
    ))}
  </ol>
</nav>

<style>
  .migalhas {
    padding: 16px 0 0;
  }
  .migalhas ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
  }
  .migalhas li + li::before {
    content: '/';
    margin-right: 8px;
    color: var(--fio-forte);
  }
  .migalhas a {
    color: var(--tinta-3);
    text-decoration: none;
  }
  .migalhas a:hover {
    color: var(--azul);
    text-decoration: underline;
  }
  .migalhas span {
    color: var(--tinta-2);
  }
</style>
