---
interface Props {
  itens: { p: string; r: string }[];
  titulo?: string;
}
const { itens, titulo = 'Perguntas que sempre aparecem' } = Astro.props;
---

<div class="faq">
  <h2>{titulo}</h2>
  <div class="itens">
    {itens.map((item, i) => (
      <details name="faq" open={i === 0}>
        <summary>
          <span>{item.p}</span>
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
          </svg>
        </summary>
        <div class="resposta"><p>{item.r}</p></div>
      </details>
    ))}
  </div>
</div>

<style>
  .faq h2 {
    margin-bottom: 22px;
  }
  .itens {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--fio);
    border: 1px solid var(--fio);
    border-radius: var(--raio);
    overflow: hidden;
  }
  details {
    background: var(--superficie);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 17px 20px;
    cursor: pointer;
    font-weight: 650;
    font-size: 17px;
    letter-spacing: -0.015em;
    list-style: none;
    transition: background var(--transicao);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    background: var(--papel);
  }
  summary svg {
    flex: none;
    color: var(--azul);
    transition: transform var(--transicao);
  }
  details[open] summary svg {
    transform: rotate(45deg);
  }
  .resposta {
    padding: 0 20px 19px;
    max-width: 72ch;
  }
  .resposta p {
    color: var(--tinta-2);
    margin: 0;
    line-height: 1.6;
  }
</style>
