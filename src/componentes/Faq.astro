---
import { empresa, zap } from '../dados/site';

interface Props {
  itens: { p: string; r: string }[];
  titulo?: string;
  apoio?: string;
  zapMensagem?: string;
}
const {
  itens,
  titulo = 'Perguntas que sempre aparecem',
  apoio = 'As dúvidas que o transportador traz na primeira conversa. Se a sua não estiver aqui, é só perguntar.',
  zapMensagem = 'Olá! Tenho uma dúvida sobre o sistema que não estava nas perguntas frequentes.',
} = Astro.props;
---

<div class="faq">
  <div class="faq-lado">
    <h2>{titulo}</h2>
    <p class="faq-apoio">{apoio}</p>

    <div class="faq-ajuda">
      <span class="rotulo">Ficou com dúvida?</span>
      <a href={zap(zapMensagem)} class="botao botao-zap" target="_blank" rel="noopener">
        Perguntar no WhatsApp
      </a>
      <a href={`tel:${empresa.telefoneLink}`} class="tel">{empresa.telefone}</a>
      <span class="horario">{empresa.horario}</span>
    </div>
  </div>

  <div class="itens">
    {itens.map((item, i) => (
      <details name="faq" open={i === 0}>
        <summary>
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="pergunta">{item.p}</span>
          <span class="mais" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="15" height="15">
              <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none" />
            </svg>
          </span>
        </summary>
        <div class="resposta"><p>{item.r}</p></div>
      </details>
    ))}
  </div>
</div>

<style>
  /* duas colunas: as perguntas ficam com largura de leitura confortavel
     e a coluna da esquerda ocupa o espaco que antes ficava vazio */
  .faq {
    display: grid;
    grid-template-columns: 0.78fr 1.22fr;
    gap: clamp(28px, 4vw, 60px);
    align-items: start;
  }

  .faq-lado {
    position: sticky;
    top: 130px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .faq-lado h2 {
    margin: 0;
  }
  .faq-apoio {
    color: var(--tinta-2);
    font-size: 17px;
    margin: 0;
    max-width: 38ch;
  }

  /* a caixa de contato e o ponto de cor da secao: escura, com o
     WhatsApp em verde. Sem ela o FAQ vira uma lista cinza. */
  .faq-ajuda {
    margin-top: 10px;
    padding: 20px 22px;
    background:
      radial-gradient(90% 80% at 90% 0%, #10496E 0%, transparent 62%),
      linear-gradient(160deg, var(--noite-2) 0%, var(--noite) 75%);
    border-radius: var(--raio);
    box-shadow: 0 20px 44px -26px rgba(3, 15, 25, 0.85);
    width: 100%;
    max-width: 330px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 11px;
  }
  .faq-ajuda .rotulo {
    color: var(--ciano);
  }
  .faq-ajuda .botao {
    width: 100%;
  }
  .faq-ajuda .tel {
    font-family: var(--f-mono);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--noite-tinta);
  }
  .faq-ajuda .tel:hover {
    color: var(--ciano);
  }
  .faq-ajuda .horario {
    font-size: 13px;
    color: var(--noite-tinta-3);
    line-height: 1.4;
  }

  .itens {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  details {
    background: var(--superficie);
    border: 1px solid var(--fio);
    border-left: 3px solid var(--fio);
    border-radius: var(--raio);
    transition: border-color var(--transicao), box-shadow var(--transicao), transform var(--transicao);
  }
  details:hover {
    border-color: var(--fio-forte);
    border-left-color: var(--ciano);
    transform: translateX(2px);
  }
  /* aberta: fio azul na lateral e leve tom de fundo, para a resposta
     em foco se destacar da lista */
  details[open] {
    border-color: var(--fio-forte);
    border-left-color: var(--azul);
    box-shadow: var(--sombra-alta);
    background: linear-gradient(180deg, var(--azul-suave) 0%, var(--superficie) 70px);
  }

  summary {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 17px 20px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .num {
    flex: none;
    font-family: var(--f-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--tinta-3);
    font-variant-numeric: tabular-nums;
    transition: color var(--transicao);
  }
  details[open] .num,
  details:hover .num {
    color: var(--azul);
  }
  .pergunta {
    flex: 1;
    font-weight: 700;
    font-size: 17.5px;
    font-stretch: 104%;
    letter-spacing: -0.018em;
    line-height: 1.3;
    min-width: 0;
  }
  .mais {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--azul-suave);
    color: var(--azul);
    transition: transform 220ms cubic-bezier(0.2, 0.7, 0.3, 1.3), background var(--transicao), color var(--transicao);
  }
  details:hover .mais {
    background: #CFE6F6;
  }
  details[open] .mais {
    transform: rotate(135deg);
    background: linear-gradient(145deg, var(--azul) 0%, var(--ciano) 100%);
    color: #fff;
    box-shadow: 0 6px 14px -7px rgba(0, 113, 187, 0.95);
  }
  .resposta {
    padding: 0 20px 20px 54px;
    max-width: 68ch;
  }
  .resposta p {
    color: var(--tinta-2);
    margin: 0;
    line-height: 1.62;
    font-size: 16.5px;
  }

  @media (max-width: 520px) {
    .resposta {
      padding-left: 20px;
    }
  }

  @media (max-width: 900px) {
    .faq {
      grid-template-columns: 1fr;
    }
    .faq-lado {
      position: static;
    }
  }
</style>
