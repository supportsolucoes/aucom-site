---
import Migalhas from './Migalhas.astro';
import { semQuebra } from '../dados/texto';
import { Image } from 'astro:assets';
import fotoRodovia from '../imagens/rodovia-interior-sp.jpg';
import fotoCarreta from '../imagens/carreta-rodovia-br.jpg';
import fotoLoja from '../imagens/loja-varejo.jpg';
import fotoPosto from '../imagens/posto.jpg';

const fotos = {
  rodovia: fotoRodovia,
  carreta: fotoCarreta,
  loja: fotoLoja,
  posto: fotoPosto,
};

interface Props {
  rotulo?: string;
  titulo: string;
  texto?: string;
  migalhas: { texto: string; href?: string }[];
  /** foto de fundo; sem isto o topo fica so no gradiente */
  foto?: keyof typeof fotos;
  /**
   * topo em superficie clara. Para pagina de leitura longa (politica,
   * termos): sem foto o topo escuro nao entrega nada visualmente e ainda
   * cobra o preco de ler texto claro sobre fundo escuro.
   */
  claro?: boolean;
}
const { rotulo, titulo, texto, migalhas, foto, claro = false } = Astro.props;
const imagem = foto && !claro ? fotos[foto] : null;
---

<section class:list={['hero-interno', { claro }]}>
  {imagem && (
    <Image
      class="hero-foto"
      src={imagem}
      alt=""
      widths={[900, 1400, 1920]}
      sizes="100vw"
      format="webp"
      quality={70}
      loading="eager"
      fetchpriority="high"
    />
  )}
  {!claro && <div class="hero-veu" aria-hidden="true"></div>}

  <div class="faixa">
    <Migalhas itens={migalhas} />
    <div class="hero-texto">
      {rotulo && <span class="rotulo">{rotulo}</span>}
      <h1 set:html={semQuebra(titulo)} />
      {texto && <p class="subtitulo" set:html={semQuebra(texto)} />}
      <slot />
    </div>
  </div>
</section>

<style>
  .hero-interno {
    position: relative;
    isolation: isolate;
    background:
      radial-gradient(90% 80% at 85% 0%, #10496E 0%, transparent 62%),
      linear-gradient(160deg, var(--noite-2) 0%, var(--noite) 72%);
    color: var(--noite-tinta);
    padding-bottom: clamp(44px, 6vw, 76px);
    overflow: hidden;
  }
  .hero-foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .hero-veu {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      95deg,
      rgba(4, 18, 29, 0.95) 0%,
      rgba(5, 22, 35, 0.9) 42%,
      rgba(6, 28, 45, 0.62) 100%
    );
  }
  .hero-texto {
    max-width: 62ch;
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
    padding-top: clamp(22px, 3vw, 34px);
  }
  .hero-texto .rotulo {
    color: var(--ciano);
  }
  .hero-texto h1 {
    color: var(--noite-tinta);
    font-weight: 740;
  }
  .hero-texto .subtitulo {
    color: var(--noite-tinta-2);
    font-weight: 410;
  }
  .hero-interno :global(.migalhas a) {
    color: var(--noite-tinta-3);
  }
  .hero-interno :global(.migalhas span) {
    color: #B8CEDC;
  }
  .hero-interno :global(.migalhas li + li::before) {
    color: #47657A;
  }

  /* ---- variante clara ---------------------------------------------
     Mesma estrutura, superficie invertida. O rotulo troca o ciano pelo
     azul institucional porque o ciano so tem contraste sobre escuro. */
  .hero-interno.claro {
    /* --papel e nao --superficie: as secoes de conteudo destas paginas sao
       brancas, entao o topo precisa ser o tom acima para virar faixa */
    background: var(--papel);
    color: var(--tinta);
    border-bottom: 1px solid var(--fio);
    padding-bottom: clamp(26px, 3.5vw, 44px);
  }
  .hero-interno.claro .hero-texto h1 {
    color: var(--tinta);
    font-weight: 800;
  }
  .hero-interno.claro .hero-texto .rotulo {
    color: var(--azul);
  }
  .hero-interno.claro .hero-texto .subtitulo {
    color: var(--tinta-2);
    font-weight: 430;
  }
  .hero-interno.claro :global(.migalhas a) {
    color: var(--tinta-2);
  }
  .hero-interno.claro :global(.migalhas span) {
    color: var(--tinta-3);
  }
  .hero-interno.claro :global(.migalhas li + li::before) {
    color: var(--fio-forte);
  }
</style>
