---
import Base from '../../layouts/Base.astro';
import HeroInterno from '../../componentes/HeroInterno.astro';
import CtaFinal from '../../componentes/CtaFinal.astro';
import Icone from '../../componentes/Icone.astro';
import { empresa, zap } from '../../dados/site';

const zapMsg = 'Olá! Vim pela página do ERP e quero saber mais sobre o sistema de gestão.';
---

<Base
  titulo="ERP para Varejo, Atacado e Postos | Aucom — 30 anos"
  descricao="Sistema de gestão para loja, atacado, distribuidora e posto de combustível: estoque, vendas, fiscal e financeiro integrados. Da Aucom, de Bauru, há mais de 30 anos."
  zapMensagem={zapMsg}
>
  <HeroInterno
    rotulo="ERP · Gestão empresarial"
    titulo="O ERP que a Aucom faz há mais de 30 anos"
    texto="Antes de atender transportadora, a Aucom automatizou loja, atacado e posto de combustível no interior de São Paulo. Essa linha continua viva, com clientes que estão com a gente há décadas."
    migalhas={[{ texto: 'ERP' }]}
    foto="loja"
  >
    <a href="/demonstracao/" class="botao botao-acao">Falar com um consultor</a>
  </HeroInterno>

  <section class="fundo-claro">
    <div class="faixa">
      <div class="cabeca">
        <span class="rotulo">Segmentos</span>
        <h2>Para qual operação você precisa de sistema</h2>
      </div>
      <div class="grade grade-2">
        <a href="/erp/varejo-e-atacado/" class="cartao cartao-link">
          <span class="icone-selo"><Icone nome="loja" /></span>
          <h3>Varejo, atacado e distribuidora</h3>
          <p>Estoque, vendas, compras, fiscal e financeiro, com aplicativo de venda e integração com e-commerce.</p>
          <span class="seta">Ver detalhes <span aria-hidden="true">→</span></span>
        </a>
        <a href="/erp/postos-de-combustivel/" class="cartao cartao-link">
          <span class="icone-selo"><Icone nome="bomba" /></span>
          <h3>Postos de combustível</h3>
          <p>Bombas, tanques, aferição, conveniência e o fiscal específico do combustível em um sistema só.</p>
          <span class="seta">Ver detalhes <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <section class="fundo-papel">
    <div class="faixa">
      <div class="cabeca">
        <span class="rotulo">Também no ERP</span>
        <h2>O que vem junto, em qualquer segmento</h2>
      </div>
      <div class="grade grade-3">
        <div class="cartao"><h3>Fiscal em dia</h3><p>NF-e, NFC-e, SPED e as obrigações que mudam todo ano, acompanhadas por quem faz isso há três décadas.</p></div>
        <div class="cartao"><h3>Estoque de verdade</h3><p>Entrada, saída, inventário e custo médio — para o estoque do sistema bater com o da prateleira.</p></div>
        <div class="cartao"><h3>Financeiro</h3><p>Contas a pagar e a receber, fluxo de caixa, conciliação bancária e cobrança.</p></div>
        <div class="cartao"><h3>Aplicativo de vendas</h3><p>Pedido feito na rua pelo representante, com preço e estoque atualizados.</p></div>
        <div class="cartao"><h3>Integração com e-commerce</h3><p>API para a loja virtual conversar com o estoque e o faturamento.</p></div>
        <div class="cartao"><h3>Suporte que atende</h3><p>Equipe própria em Bauru. Quem responde conhece o seu sistema e o seu segmento.</p></div>
      </div>
    </div>
  </section>

  <section class="fundo-escuro">
    <div class="faixa aviso-tms">
      <div>
        <span class="rotulo">Se a sua operação é transporte</span>
        <h2>Para transportadora, o caminho é o TMS</h2>
        <p>
          O ERP cuida da retaguarda de quem vende. Quem transporta precisa de CT-e, MDF-e, CIOT, frota,
          jornada e risco — e isso é o TMS da Aucom.
        </p>
      </div>
      <a href="/tms/" class="botao botao-claro">Conhecer o TMS</a>
    </div>
  </section>

  <CtaFinal
    zapMensagem={zapMsg}
    titulo="Precisa de sistema para a sua empresa?"
    texto="Fale com quem atende comércio no interior de São Paulo há mais de 30 anos."
  />
</Base>

<style>
  .cartao h3 {
    font-size: 18px;
    margin-bottom: 7px;
  }
  .cartao p {
    color: var(--tinta-2);
    font-size: 15.5px;
    line-height: 1.55;
    margin: 0;
  }
  .aviso-tms {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  .aviso-tms p {
    max-width: 58ch;
    margin-top: 10px;
  }
</style>
