---
import Base from '../layouts/Base.astro';
import HeroInterno from '../componentes/HeroInterno.astro';
import CtaFinal from '../componentes/CtaFinal.astro';
import { empresa } from '../dados/site';

const zapMsg = 'Olá! Vi a página de clientes e queria conversar sobre o sistema.';
---

<Base
  titulo="Transportadoras que usam a Aucom | Clientes"
  descricao="Conheça transportadoras e empresas que controlam operação, documentos e risco com os sistemas da Aucom, de Bauru, há mais de 30 anos."
  zapMensagem={zapMsg}
>
  <HeroInterno
    rotulo="Clientes"
    titulo="Quem roda a operação com a Aucom"
    texto="Transportadoras, distribuidoras, lojas e postos do interior de São Paulo, muitos com a gente há mais de uma década."
    migalhas={[{ texto: 'Clientes' }]}
    foto="rodovia"
  />

  <section class="fundo-claro">
    <div class="faixa">
      <div class="pendente-grande">
        <span class="rotulo">Página a completar com a Aucom</span>
        <h2>Esta é a página que mais pesa na decisão de quem ainda não conhece a empresa</h2>
        <p>
          Ela substitui a antiga página "em construção", que hoje aparece no Google associada à marca.
          Para publicá-la de verdade, precisamos de material que só a Aucom tem:
        </p>
        <ul class="lista sinal">
          <li><strong>3 a 5 clientes</strong> dispostos a serem citados pelo nome, com autorização de uso do logo.</li>
          <li><strong>Um número por cliente:</strong> anos de casa, tamanho da frota atendida ou volume de documentos emitidos por mês.</li>
          <li><strong>Uma frase de cada um</strong> sobre o que mudou depois do sistema. Vale gravar por WhatsApp e transcrever.</li>
          <li><strong>Foto real:</strong> caminhão com a marca do cliente, o escritório, a equipe. Foto de banco não convence transportador.</li>
        </ul>
        <p class="obs">
          Enquanto o material não chega, esta página fica fora do menu e do sitemap: melhor não ter
          do que ter vazia, que foi o problema do site anterior.
        </p>
      </div>

      <div class="grade grade-3 exemplos">
        <div class="cartao vazio">
          <span class="rotulo">Case 1</span>
          <h3>Nome da transportadora</h3>
          <p>Segmento, cidade, tamanho da frota. O que travava antes e o que mudou.</p>
          <span class="numero">— anos com a Aucom</span>
        </div>
        <div class="cartao vazio">
          <span class="rotulo">Case 2</span>
          <h3>Nome da transportadora</h3>
          <p>Segmento, cidade, tamanho da frota. O que travava antes e o que mudou.</p>
          <span class="numero">— CT-e por mês</span>
        </div>
        <div class="cartao vazio">
          <span class="rotulo">Case 3</span>
          <h3>Nome da empresa</h3>
          <p>Segmento, cidade, porte. O que travava antes e o que mudou.</p>
          <span class="numero">— anos com a Aucom</span>
        </div>
      </div>
    </div>
  </section>

  <CtaFinal zapMensagem={zapMsg} titulo="Quer conversar com quem já usa?" texto="Podemos indicar um cliente do seu porte para você conversar antes de decidir." />
</Base>

<style>
  .pendente-grande {
    max-width: 76ch;
    border-left: 3px solid var(--sinal);
    padding-left: 22px;
    margin-bottom: 40px;
  }
  .pendente-grande .rotulo {
    color: var(--sinal-esc);
    margin-bottom: 10px;
  }
  .pendente-grande h2 {
    margin-bottom: 14px;
  }
  .pendente-grande p {
    color: var(--tinta-2);
  }
  .pendente-grande li {
    color: var(--tinta-2);
  }
  .obs {
    font-size: 15px;
    color: var(--tinta-3);
    margin-top: 16px;
  }
  .vazio {
    border-style: dashed;
    background: transparent;
    box-shadow: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .vazio h3 {
    color: var(--tinta-3);
  }
  .vazio p {
    color: var(--tinta-3);
    font-size: 15px;
    margin: 0;
  }
  .numero {
    font-family: var(--f-mono);
    font-size: 13px;
    color: var(--fio-forte);
    margin-top: auto;
  }
</style>
