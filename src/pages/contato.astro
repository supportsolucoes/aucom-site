---
import Base from '../layouts/Base.astro';
import HeroInterno from '../componentes/HeroInterno.astro';
import Formulario from '../componentes/Formulario.astro';
import { empresa, zap, enderecoLinha } from '../dados/site';

const zapMsg = 'Olá! Vim pela página de contato do site da Aucom.';
---

<Base
  titulo="Contato | Aucom Sistemas para Transportadoras"
  descricao="Fale com a Aucom por telefone, WhatsApp ou e-mail. Atendimento próprio em Bauru, interior de São Paulo, de segunda a sexta."
  zapMensagem={zapMsg}
>
  <HeroInterno
    rotulo="Contato"
    titulo="Fale com a gente"
    texto="Atendimento próprio, em Bauru. Quem responde conhece transporte, e conhece o sistema."
    migalhas={[{ texto: 'Contato' }]}
    foto="carreta"
  />

  <section class="fundo-claro">
    <div class="faixa contato-grade">
      <div class="canais">
        <div class="canal">
          <span class="rotulo">WhatsApp</span>
          <a href={zap(zapMsg)} target="_blank" rel="noopener" class="destaque-link">
            Abrir conversa
          </a>
          <p>O jeito mais rápido. Respondemos dentro do horário comercial.</p>
        </div>

        <div class="canal">
          <span class="rotulo">Telefone</span>
          <a href={`tel:${empresa.telefoneLink}`} class="destaque-link mono">{empresa.telefone}</a>
          <p>{empresa.horario}</p>
        </div>

        <div class="canal">
          <span class="rotulo">E-mail</span>
          <a href={`mailto:${empresa.email}`} class="destaque-link mono">{empresa.email}</a>
          <p>Para propostas, documentos e assuntos que precisam ficar registrados.</p>
        </div>

        <div class="canal">
          <span class="rotulo">Já é cliente?</span>
          <a href={empresa.areaCliente} rel="noopener" class="destaque-link">Área do cliente</a>
          <p>Acesso ao sistema e aos canais de suporte.</p>
        </div>

        <div class="canal">
          <span class="rotulo">Onde estamos</span>
          <address class="endereco">
            {empresa.endereco.logradouro}, {empresa.endereco.complemento}<br />
            {empresa.endereco.bairro}, {empresa.cidade}/{empresa.uf}<br />
            CEP {empresa.endereco.cep}
          </address>
          <p>Atendimento presencial com hora marcada. Ligue ou chame no WhatsApp antes de vir.</p>
        </div>
      </div>

      <div class="lado-form">
        <Formulario
          origem="pagina-contato"
          titulo="Prefere que a gente ligue?"
          apoio="Deixe seus dados e retornamos em até 1 dia útil."
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .contato-grade {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }
  .canais {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 26px 30px;
  }
  .canal {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .destaque-link {
    font-size: 19px;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.015em;
  }
  .destaque-link:hover {
    text-decoration: underline;
  }
  .destaque-link.mono {
    font-family: var(--f-mono);
    font-size: 17px;
  }
  .destaque-link.sem-link {
    color: var(--tinta);
  }
  .canal p {
    font-size: 14.5px;
    color: var(--tinta-2);
    line-height: 1.5;
    margin: 0;
  }
  .endereco {
    font-style: normal;
    font-size: 16px;
    line-height: 1.55;
    color: var(--tinta);
    font-weight: 540;
  }

  @media (max-width: 900px) {
    .contato-grade {
      grid-template-columns: 1fr;
    }
  }
</style>
